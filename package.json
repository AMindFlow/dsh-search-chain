{
  "name": "dsh-search-chain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH 网页搜索链插件（自定义多供应商回退链）",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client-entry.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./src/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-web-search-deepseek": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.2-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 test/",
    "verify:desktop-43": "node scripts/verify-desktop-43.mjs"
  }
}
